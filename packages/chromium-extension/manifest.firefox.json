{
  "manifest_version": 3,
  "name": "Simurgh Context Inspector",
  "version": "0.1.0",
  "description": "Inspect selected context from supported Grafana panels.",
  "icons": {
    "16": "icons/simurgh-mark-16.png",
    "32": "icons/simurgh-mark-32.png",
    "48": "icons/simurgh-mark-48.png",
    "128": "icons/simurgh-mark-128.png"
  },
  "permissions": [],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "include_globs": [
        "http://localhost:3300/*",
        "http://127.0.0.1:3300/*"
      ],
      "js": ["firefox-bootstrap.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Simurgh Context Inspector",
    "default_icon": {
      "16": "icons/simurgh-mark-16.png",
      "32": "icons/simurgh-mark-32.png",
      "48": "icons/simurgh-mark-48.png",
      "128": "icons/simurgh-mark-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "simurgh-context-inspector@simurgh.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
